# virtual env
.v*/
.jp2s_venv/

#temporaryfiles
temp/

#whl files
whl/
*.whl
*.gz

#__pycache__
__pycache__/


#databases
*.accdb
*.sqlitdb
*.*db
*.mdb
*.mdf
*.ldf
databases/

#this should be inculded in the .gitignore file
!db/
!db/*.bas
!db/*.frm
!db/*.frx
!db/*.vbp
!db/*.vbw
!db/*.cls

#build
docs/build/

# Node artifact files
node_modules/
dist/

# Compiled Java class files
*.class

# Compiled Python bytecode
*.py[cod]

# Log files
*.log
# Excel files
*.xlsx

# Package files
*.jar

#caches
.pytest_cache


# Maven
target/
dist/

# JetBrains IDE
.idea/

# Unit test reports
TEST*.xml

# Generated by MacOS
.DS_Store

# Generated by Windows
Thumbs.db

# Applications
*.app
*.exe
*.war

# Local caches / build artifacts
.pylint-cache/
.ruff_cache/
.pytest_cache/
build/
dist/
inventorymanager.egg-info/
*.egg-info/
.secrets

# Large media files
*.mp4
*.tiff
*.avi
*.flv
*.mov
*.wmv

# Test
tests/

# Local backup archives
backups/
